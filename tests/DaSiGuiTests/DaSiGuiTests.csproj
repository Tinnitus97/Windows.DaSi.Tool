<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prueft die Oberflaeche: das echte Hauptfenster samt ViewModel, ohne
    Bildschirm (Avalonia.Headless). Bewusst kein Testframework - wie
    tests/DaSiTests ein eigenes Programm mit "[OK]"/"[FAIL]"-Zeilen.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaSiGuiTests</RootNamespace>
    <AssemblyName>DaSiGuiTests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../WindowsDaSiTool.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <Compile Include="../Gemeinsam/*.cs" />
  </ItemGroup>

  <!-- Die winget-Attrappe wird mitgebaut - in ihren eigenen Ordner. Ein
       Projektverweis kopierte ihre Startdatei winget.exe (ohne winget.dll)
       hierher, und Windows faende "winget" dann zuerst hier, im Ordner des
       Pruefprogramms, statt im Suchpfad. -->
  <Target Name="WingetAttrappeBauen" BeforeTargets="Build">
    <MSBuild Projects="../WingetAttrappe/WingetAttrappe.csproj" Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
