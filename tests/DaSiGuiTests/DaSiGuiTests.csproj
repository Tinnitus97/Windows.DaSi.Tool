<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the UI: the real main window with its ViewModel, without a screen
    (Avalonia.Headless). Deliberately no test framework - like
    tests/DaSiTests, a program of its own with "[OK]"/"[FAIL]" lines.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaSiGuiTests</RootNamespace>
    <AssemblyName>DaSiGuiTests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../WindowsDaSiTool.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>

  <!-- The winget fake is built along - into its own folder. A project
       reference would copy its launcher winget.exe (without winget.dll)
       here, and Windows would then find "winget" here first, in the test
       program's folder, instead of in the search path. -->
  <Target Name="BuildWingetFake" BeforeTargets="Build">
    <!-- Restore first (own properties = separate pass), then build. -->
    <MSBuild Projects="../WingetFake/WingetFake.csproj" Targets="Restore" Properties="Configuration=$(Configuration);DaSiRestore=true" />
    <MSBuild Projects="../WingetFake/WingetFake.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
