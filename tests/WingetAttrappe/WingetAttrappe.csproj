<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A fake winget for the tests: answers like winget, as dictated by the file
    szenario.txt in the folder from DASI_WINGET_ATTRAPPE, and writes every
    call to aufrufe.txt. That way every path of WingetService (export,
    import, repair, reinstall) runs without installing anything on the test
    machine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>winget</AssemblyName>
    <RootNamespace>WingetAttrappe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
