<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Eine Attrappe von winget fuer die Pruefungen: antwortet wie winget, so wie
    es die Datei szenario.txt im Ordner aus DASI_WINGET_ATTRAPPE vorgibt, und
    schreibt jeden Aufruf nach aufrufe.txt. Damit laeuft jeder Weg von
    WingetService (Export, Import, Reparatur, Nachinstallation), ohne dass auf
    dem Pruefrechner etwas installiert wird.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>winget</AssemblyName>
    <RootNamespace>WingetAttrappe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
