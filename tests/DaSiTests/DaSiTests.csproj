<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the services without the UI.

    Deliberately NO test framework and NO Avalonia: the files under test do
    not need the UI (tests/DaSiGuiTests tests the UI). The program only runs
    on Windows, so the tests do as well - in CI on a Windows runner.

    The source files are included instead of referenced - the main project
    targets Windows and could not be compiled next to it otherwise.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Every warning stops the tests - so compiler hints (e.g. CA1416) do
         not go unnoticed in the log. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaSiTests</RootNamespace>
    <AssemblyName>DaSiTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- On Windows additionally UI Automation (from WPF): the taskbar trial
       uses it to read the visible buttons of the taskbar. Only there - on
       Linux the tests stay startable without the Windows desktop runtime. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);MIT_UIA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Include="TaskleistenVersuch.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="DienstPruefungen.cs" />
    <Compile Include="WingetPruefungen.cs" />
    <Compile Include="SicherungsPruefungen.cs" />
    <Compile Include="MozillaPruefungen.cs" />
    <Compile Include="VerknuepfungsPruefungen.cs" />
    <Compile Include="ThunderbirdEcht.cs" />
    <Compile Include="FirefoxUmzugEcht.cs" />
    <Compile Include="LaufwerkPruefungen.cs" />
    <Compile Include="../Gemeinsam/*.cs" />
    <Compile Include="../../Services/UpdateService.cs" />
    <Compile Include="../../Services/CloudProviders.cs" />
    <Compile Include="../../Services/ProfileExcludes.cs" />
    <Compile Include="../../Services/ActionOutcome.cs" />
    <Compile Include="../../Services/PngWriter.cs" />
    <Compile Include="../../Services/BackupTarget.cs" />
    <Compile Include="../../Services/DesktopScreenshot.cs" />
    <Compile Include="../../Services/RobocopySkips.cs" />
    <Compile Include="../../Services/ProfilePaths.cs" />
    <Compile Include="../../Services/ProfileLinks.cs" />
    <Compile Include="../../Services/AppCatalog.cs" />
    <Compile Include="../../Services/LaufwerksOrdner.cs" />
    <Compile Include="../../Services/DesktopIcons.cs" />
    <Compile Include="../../Services/WingetInstaller.cs" />
    <Compile Include="../../Services/WingetFehler.cs" />
    <Compile Include="../../Services/ProfilAbgleich.cs" />
    <Compile Include="../../Services/MozillaProfile.cs" />
    <Compile Include="../../Services/Hintergrund.cs" />
    <Compile Include="../../Services/DesignEinstellungen.cs" />
    <Compile Include="../../Services/DesignRegistry.cs" />
    <Compile Include="../../Services/Taskleiste.cs" />
    <Compile Include="../../Services/Verknuepfung.cs" />
    <Compile Include="../../Services/TaskleistenAnsicht.cs" />
    <Compile Include="../../Services/ExplorerNeustart.cs" />
    <Compile Include="../../Services/DesktopHintergrund.cs" />
    <Compile Include="../../Services/DesignDatei.cs" />
    <Compile Include="../../Services/WindowsDesign.cs" />
    <Compile Include="../../Services/Localizer.cs" />
    <Compile Include="../../Services/BackupService.cs" />
    <Compile Include="../../Services/WingetService.cs" />
    <Compile Include="../../Services/WingetModels.cs" />
    <Compile Include="../../Services/ProcessRunner.cs" />
    <Compile Include="../../Services/SystemHelpers.cs" />
    <Compile Include="../../Services/PerformanceMode.cs" />
    <Compile Include="../../Services/CancellationTokenState.cs" />
  </ItemGroup>

  <!-- The winget fake is built along - into its own folder. A project
       reference would copy its launcher winget.exe (without winget.dll)
       here, and Windows would then find "winget" here first, in the test
       program's folder, instead of in the search path. -->
  <Target Name="WingetAttrappeBauen" BeforeTargets="Build">
    <!-- Restore first (own properties = separate pass), then build. -->
    <MSBuild Projects="../WingetAttrappe/WingetAttrappe.csproj" Targets="Restore" Properties="Configuration=$(Configuration);DaSiRestore=true" />
    <MSBuild Projects="../WingetAttrappe/WingetAttrappe.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
