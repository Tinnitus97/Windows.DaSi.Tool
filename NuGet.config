<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Erzwingt nuget.org als Paketquelle fuer dieses Projekt.
    <clear/> entfernt zuvor geerbte (evtl. defekte oder firmeninterne)
    Quellen, sodass der Restore unabhaengig von den Maschineneinstellungen
    funktioniert. Ursache des NU1100-Fehlers war eine fehlende/deaktivierte
    nuget.org-Quelle.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Falls zuvor als deaktiviert markiert: hier wieder aktivieren -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
