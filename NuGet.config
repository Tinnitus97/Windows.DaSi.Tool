<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Forces nuget.org as the package source for this project.
    <clear/> removes previously inherited (possibly broken or company
    internal) sources, so the restore works regardless of the machine's
    settings. The NU1100 error was caused by a missing/disabled nuget.org
    source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- If it was marked as disabled before: enable it again here -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
