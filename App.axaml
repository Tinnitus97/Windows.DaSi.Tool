<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WindowsDaSiTool.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ===== Dark theme (Catppuccin Mocha) ===== -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>
                    <SolidColorBrush x:Key="CrustBrush" Color="#11111B"/>
                    <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
                    <SolidColorBrush x:Key="Surface1Brush" Color="#45475A"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#2A2A3E"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
                    <SolidColorBrush x:Key="SubtextBrush" Color="#A6ADC8"/>
                    <SolidColorBrush x:Key="OverlayBrush" Color="#6C7086"/>
                    <SolidColorBrush x:Key="BlueBrush" Color="#89B4FA"/>
                    <SolidColorBrush x:Key="LavenderBrush" Color="#B4BEFE"/>
                    <SolidColorBrush x:Key="GreenBrush" Color="#A6E3A1"/>
                    <SolidColorBrush x:Key="RedBrush" Color="#F38BA8"/>
                    <SolidColorBrush x:Key="YellowBrush" Color="#F9E2AF"/>
                </ResourceDictionary>

                <!-- ===== Light theme (Catppuccin Latte) ===== -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BaseBrush" Color="#EFF1F5"/>
                    <SolidColorBrush x:Key="CrustBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Surface0Brush" Color="#CCD0DA"/>
                    <SolidColorBrush x:Key="Surface1Brush" Color="#BCC0CC"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#E6E9EF"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#4C4F69"/>
                    <SolidColorBrush x:Key="SubtextBrush" Color="#6C6F85"/>
                    <SolidColorBrush x:Key="OverlayBrush" Color="#9CA0B0"/>
                    <SolidColorBrush x:Key="BlueBrush" Color="#1E66F5"/>
                    <SolidColorBrush x:Key="LavenderBrush" Color="#7287FD"/>
                    <SolidColorBrush x:Key="GreenBrush" Color="#40A02B"/>
                    <SolidColorBrush x:Key="RedBrush" Color="#D20F39"/>
                    <SolidColorBrush x:Key="YellowBrush" Color="#DF8E1D"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,2,8"/>
        </Style>

        <!-- ============ App title / subtitle ============ -->
        <Style Selector="TextBlock.appTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.appSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Segment switch (backup/restore) ============ -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="seg" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="12,6">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover /template/ Border#seg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#seg">
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style Selector="Border.segmentBar">
            <Setter Property="Background" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ============ Panel card (group container) ============ -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ============ ComboBox (quick selection) ============ -->
        <Style Selector="ComboBox.quick">
            <Setter Property="Background" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============ Card checkbox ============
             The CheckBox itself carries NO border any more. The card look
             (border, background, corners) comes from the surrounding Border
             "cardHost". That way the check box reliably keeps its distance
             from the outline, independent of template internals. -->
        <Style Selector="Border.cardHost">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <!-- MinHeight is the LOWER LIMIT, not the height: the card area gets the
                 remaining space of the left column through "*", and its grid of
                 equal "*" rows shares it evenly. So the cards are as large as the
                 window allows.

                 The value must stay small enough for the sum of all rows to fit
                 below the visible height at the default size (1200x720) - ALSO
                 when the storage check shows its line below the buttons (32 px).
                 The real brake sits in the checkbox, though: see CheckBoxMinHeight
                 in MainWindow.axaml.
                 The cards are still rendered taller, because they share the free
                 space.

                 There are 6 rows (5 with two cards each, plus "Design & Desktop"
                 across the full width): a lower limit of 24 instead of 28 px keeps
                 the sum below the visible height. -->
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.cardHost:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>

        <Style Selector="CheckBox.card">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox.card TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="CheckBox.card:checked">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
        </Style>

        <!-- Sub-items of a card (AppData, cloud providers). Smaller and paler
             than the card itself, so one can see at a glance that they belong to
             it and are not on the same level. -->
        <Style Selector="CheckBox.subCard">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox.subCard TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Radio choice inside a card (formerly Desktop layout: screenshot /
             icon positions; not used at the moment). A flat template of its
             own: the Fluent RadioButton is 32 px tall and made the card row
             taller than the others. -->
        <Style Selector="RadioButton.subRadio">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="{TemplateBinding Background}">
                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Name="ring" Width="16" Height="16" StrokeThickness="1.5"
                                     Stroke="{DynamicResource SubtextBrush}" Fill="Transparent"/>
                            <Ellipse Name="dot" Width="6" Height="6" Fill="White" IsVisible="False"/>
                        </Panel>
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.subRadio:pointerover /template/ Ellipse#ring">
            <Setter Property="Stroke" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style Selector="RadioButton.subRadio:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="RadioButton.subRadio:checked /template/ Ellipse#ring">
            <Setter Property="Fill" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
        <Style Selector="RadioButton.subRadio:checked /template/ Ellipse#dot">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="RadioButton.subRadio:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="CheckBox.subCard:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- Locked (program missing / not in the backup): clearly paler.
             Also for the sub-items - their fixed text color would otherwise hide
             that they are locked. -->
        <Style Selector="CheckBox.card:disabled, CheckBox.subCard:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- ============ Primary action button ============ -->
        <Style Selector="Button.action">
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4,6,4,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LavenderBrush}"/>
        </Style>
        <Style Selector="Button.action:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- ============ Secondary button ============ -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- ============ Exit button ============ -->
        <Style Selector="Button.exit">
            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
        </Style>

        <!-- ============ Dialogs (messages, prompts, winget selection) ============
             The same theme colors as the main window - the colors used to be
             hard-coded, and the dialogs stayed dark in light mode. -->
        <Style Selector="Window.dialog">
            <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock.dialogText">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock.dialogTitle">
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.dialogList">
            <Setter Property="Background" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="CheckBox.dialogItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Dialog buttons: neutral, "yes"/"install" (green), "ok" (blue), "cancel" (red) -->
        <Style Selector="Button.dialog">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dialog:pointerover /template/ ContentPresenter, Button.dialog:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.dialog.yes">
            <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
        </Style>
        <Style Selector="Button.dialog.yes:pointerover /template/ ContentPresenter, Button.dialog.yes:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.dialog.ok">
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
        </Style>
        <Style Selector="Button.dialog.ok:pointerover /template/ ContentPresenter, Button.dialog.ok:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LavenderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CrustBrush}"/>
        </Style>
        <Style Selector="Button.dialog.cancel">
            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        </Style>
        <Style Selector="Button.dialog.cancel:pointerover /template/ ContentPresenter, Button.dialog.cancel:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        </Style>

        <!-- ============ Path text box ============ -->
        <Style Selector="TextBox.path">
            <Setter Property="Background" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Styles>
</Application>
