<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WindowsDaSiTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="WindowsDaSiTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="960" MinHeight="540"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BaseBrush}"
        Icon="/Assets/app.ico">

    <Grid Margin="16" RowDefinitions="Auto,*">

        <!-- ============ Kopfzeile ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,14">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="appTitle" Text="{Binding WindowTitle}"/>
                <TextBlock Classes="appSubtitle" Text="{Binding AppSubtitle}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button Classes="secondary" Width="46" Content="{Binding ThemeIcon}"
                        FontSize="18" ToolTip.Tip="Hell-/Dunkelmodus"
                        Command="{Binding ToggleThemeCommand}"/>
                <ComboBox Classes="quick" Width="150" VerticalAlignment="Center"
                          ItemsSource="{Binding Languages}"
                          SelectedIndex="{Binding SelectedLanguageIndex}"/>
            </StackPanel>
        </Grid>

        <!-- ============ Hauptbereich: zwei Spalten ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="6*,4*">

            <!-- ============ Linke Spalte: Bedienung ============ -->
            <Grid Grid.Column="0" Margin="0,0,12,0" RowDefinitions="*,Auto">

                <!-- Scrollbarer Bereich: passt sich kleinen Fensterhoehen an.
                     Der Inhalt ist ueber MinHeight an die Hoehe des Sichtfensters
                     gebunden. Dadurch kann die Kachelflaeche darunter mit "*" den
                     verbleibenden Platz ausfuellen - ohne die Bindung bekaeme sie
                     im ScrollViewer unendlich viel Hoehe angeboten und fiele auf
                     ihre Inhaltsgroesse zurueck. Wird der Inhalt hoeher als das
                     Fenster, greift wie bisher der Rollbalken. -->
                <ScrollViewer Name="LeftScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <Grid RowDefinitions="Auto,*" MinHeight="{Binding #LeftScroll.Bounds.Height}">

                <!-- Optionen & Verzeichnisse -->
                <Border Grid.Row="0" Classes="panel" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{Binding SectionOptions}"/>

                        <Grid ColumnDefinitions="130,*,44" Margin="0,0,0,6">
                            <TextBlock Classes="fieldLabel" Text="{Binding LabelQuickSelect}"/>
                            <ComboBox Grid.Column="1" Classes="quick"
                                      ItemsSource="{Binding UserProfiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      PlaceholderText="{Binding QuickSelectHint}"
                                      IsEnabled="{Binding UiEnabled}"/>
                        </Grid>

                        <Grid ColumnDefinitions="130,*,44" Margin="0,0,0,6">
                            <TextBlock Classes="fieldLabel" Text="{Binding LabelUserProfile}"/>
                            <TextBox Grid.Column="1" Classes="path" Text="{Binding SourcePath}"/>
                            <Button Grid.Column="2" Content="…" Margin="6,0,0,0" Classes="secondary"
                                    Command="{Binding SelectSourceCommand}" IsEnabled="{Binding UiEnabled}"/>
                        </Grid>

                        <Grid ColumnDefinitions="130,*,44" Margin="0,0,0,10">
                            <TextBlock Classes="fieldLabel" Text="{Binding LabelBackupTarget}"/>
                            <TextBox Grid.Column="1" Classes="path" Text="{Binding BackupPath}"/>
                            <Button Grid.Column="2" Content="…" Margin="6,0,0,0" Classes="secondary"
                                    Command="{Binding SelectBackupCommand}" IsEnabled="{Binding UiEnabled}"/>
                        </Grid>

                        <!-- Oben drei Knoepfe, unten zwei - auf sechs Spalten verteilt,
                             damit beide Reihen buendig abschliessen. Eine dritte
                             Reihe haette wieder einen Rollbalken erzwungen. -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Grid.ColumnSpan="2" Classes="secondary" Content="{Binding BtnClearPaths}"
                                    Command="{Binding ClearPathsCommand}" IsEnabled="{Binding UiEnabled}"/>
                            <Button Grid.Column="2" Grid.ColumnSpan="2" Classes="secondary" Content="{Binding LoggingLabel}"
                                    Command="{Binding ToggleLoggingCommand}" IsEnabled="{Binding UiEnabled}"/>
                            <Button Grid.Column="4" Grid.ColumnSpan="2" Classes="secondary" Content="{Binding OwnFolderLabel}"
                                    ToolTip.Tip="{Binding OwnFolderTip}"
                                    Command="{Binding ToggleOwnFolderCommand}" IsEnabled="{Binding OwnFolderToggleEnabled}"/>
                        </Grid>

                        <!-- Speicherueberwachung -->
                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                            <Button Grid.Column="0" Classes="secondary" Margin="0,0,4,0"
                                    Content="{Binding BtnCheckStorage}"
                                    Command="{Binding CheckStorageCommand}"
                                    IsEnabled="{Binding UiEnabled}"/>
                            <Button Grid.Column="1" Classes="secondary" Margin="4,0,0,0"
                                    Content="{Binding AutoStorageLabel}"
                                    Command="{Binding ToggleAutoStorageCommand}"
                                    IsEnabled="{Binding UiEnabled}"/>
                        </Grid>
                        <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="5"
                                IsVisible="{Binding StorageInfoVisible}"
                                Background="{DynamicResource Surface0Brush}">
                            <TextBlock Text="{Binding StorageInfo}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{Binding StorageBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Aktionen: umschaltbar zwischen Sichern und Wiederherstellen -->
                <Border Grid.Row="1" Classes="panel">
                    <!-- Das Fluent-Design gibt dem Kaestchen jeder Checkbox einen Kasten
                         mit fester Hoehe aus der Ressource CheckBoxMinHeight (32 px) -
                         nicht ueber MinHeight, sondern als Height in der Vorlage. Deshalb
                         wirkt nur das Ueberschreiben der Ressource. Bewusst hier und nicht
                         in App.axaml: So gilt es nur fuer die Kacheln, und die Checkboxen
                         in anderen Fenstern (etwa der Winget-Auswahl) bleiben, wie sie sind. -->
                    <Border.Resources>
                        <!-- 22: passt in die 24 px hohe Kachel (1 px Rahmen oben und unten). -->
                        <x:Double x:Key="CheckBoxMinHeight">22</x:Double>
                    </Border.Resources>
                    <Grid RowDefinitions="Auto,Auto,*">
                            <!-- Umschalter -->
                            <Border Grid.Row="0" Classes="segmentBar">
                                <Grid ColumnDefinitions="*,*">
                                    <RadioButton Grid.Column="0" Classes="segment" GroupName="mode"
                                                 Content="{Binding TabBackup}"
                                                 IsChecked="{Binding IsBackupMode, Mode=TwoWay}"
                                                 IsEnabled="{Binding UiEnabled}"/>
                                    <RadioButton Grid.Column="1" Classes="segment" GroupName="mode"
                                                 Content="{Binding TabRestore}"
                                                 IsChecked="{Binding IsRestoreMode, Mode=TwoWay}"
                                                 IsEnabled="{Binding UiEnabled}"/>
                                </Grid>
                            </Border>

                            <!-- Das Benutzerprofil steht ueber voller Breite und traegt seine
                                 beiden Zusatzoptionen gleich bei sich. Sie gehoeren fachlich dazu
                                 und waeren als eigene Kacheln in der Reihe nicht als Unterpunkte
                                 erkennbar. Beide sind nur bedienbar, wenn das Profil gewaehlt ist,
                                 und stehen bewusst auf AUS. -->
                            <!-- Ausrichtung: Margin 3 + Rahmen 1 + Padding 14 sind dieselben 18 px
                                 wie bei den Kacheln darunter, und "*,*" teilt die Kachel genau in
                                 der Mitte. Dadurch steht das Profil-Kaestchen buendig ueber der
                                 linken Spalte und - mit nochmals 18 px Einzug - die Unterpunkte
                                 buendig ueber der rechten. -->
                            <Border Grid.Row="1" Classes="cardHost" Margin="3,2,3,2" Padding="14,3">
                                <Grid ColumnDefinitions="*,*">
                                    <CheckBox Grid.Column="0" Classes="card" VerticalAlignment="Center"
                                              Content="{Binding TgUserProfile}"
                                              IsChecked="{Binding SelUser}" IsEnabled="{Binding EnUser}"
                                              ToolTip.Tip="{Binding TipUser}" ToolTip.ShowOnDisabled="True"/>
                                    <!-- Die beiden Unterpunkte untereinander, buendig mit den
                                         Kaestchen der rechten Kachelspalte. -->
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="18,0,0,0"
                                                VerticalAlignment="Center">
                                        <!-- Unterpunkte noch enger: zwei uebereinander sollen
                                             die Kachel nur so hoch machen wie noetig. -->
                                        <StackPanel.Resources>
                                            <x:Double x:Key="CheckBoxMinHeight">21</x:Double>
                                        </StackPanel.Resources>
                                        <CheckBox Classes="subCard"
                                                  Content="{Binding TgUserAppData}"
                                                  IsChecked="{Binding SelUserAppData}"
                                                  IsEnabled="{Binding EnAppData}"
                                                  ToolTip.Tip="{Binding TipAppData}" ToolTip.ShowOnDisabled="True"/>
                                        <CheckBox Classes="subCard"
                                                  Content="{Binding TgUserCloud}"
                                                  IsChecked="{Binding SelUserCloud}"
                                                  IsEnabled="{Binding EnCloud}"
                                                  ToolTip.Tip="{Binding TipCloud}" ToolTip.ShowOnDisabled="True"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Freigabe und Tooltip je Kachel: gesperrt, wenn das Programm beim
                                 Benutzer fehlt (Sichern) oder die Sicherung den Punkt nicht
                                 enthaelt (Wiederherstellen). Der Tooltip nennt den Grund. -->
                            <!-- Feste Zeilen statt UniformGrid: Das Desktop-Layout steht unten ueber
                                 volle Breite (mit Auswahl), alle Zeilen bleiben gleich hoch. -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*">
                                <Border Grid.Row="0" Grid.Column="0" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgFirefox}" IsChecked="{Binding SelFirefox}" IsEnabled="{Binding EnFirefox}" ToolTip.Tip="{Binding TipFirefox}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgEdge}" IsChecked="{Binding SelEdge}" IsEnabled="{Binding EnEdge}" ToolTip.Tip="{Binding TipEdge}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="1" Grid.Column="0" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgChrome}" IsChecked="{Binding SelChrome}" IsEnabled="{Binding EnChrome}" ToolTip.Tip="{Binding TipChrome}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgBrave}" IsChecked="{Binding SelBrave}" IsEnabled="{Binding EnBrave}" ToolTip.Tip="{Binding TipBrave}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="2" Grid.Column="0" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgOpera}" IsChecked="{Binding SelOpera}" IsEnabled="{Binding EnOpera}" ToolTip.Tip="{Binding TipOpera}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="2" Grid.Column="1" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgThunderbird}" IsChecked="{Binding SelThunderbird}" IsEnabled="{Binding EnThunderbird}" ToolTip.Tip="{Binding TipThunderbird}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="3" Grid.Column="0" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgWinget}" IsChecked="{Binding SelWinget}" IsEnabled="{Binding EnWinget}" ToolTip.Tip="{Binding TipWinget}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="3" Grid.Column="1" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgWlan}" IsChecked="{Binding SelWlan}" IsEnabled="{Binding EnWlan}" ToolTip.Tip="{Binding TipWlan}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="4" Grid.Column="0" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgPrinter}" IsChecked="{Binding SelPrinter}" IsEnabled="{Binding EnPrinter}" ToolTip.Tip="{Binding TipPrinter}" ToolTip.ShowOnDisabled="True"/></Border>
                                <Border Grid.Row="4" Grid.Column="1" Classes="cardHost"><CheckBox Classes="card" Content="{Binding TgWallpaper}" IsChecked="{Binding SelWallpaper}" IsEnabled="{Binding EnWallpaper}" ToolTip.Tip="{Binding TipWallpaper}" ToolTip.ShowOnDisabled="True"/></Border>

                                <!-- Desktop-Layout: Screenshot ODER Symbolpositionen (wie DesktopOK).
                                     Aufbau wie die Profilkachel - die Auswahl steht buendig ueber
                                     der rechten Kachelspalte. -->
                                <Border Grid.Row="5" Grid.ColumnSpan="2" Classes="cardHost">
                                    <Grid ColumnDefinitions="*,*">
                                        <CheckBox Grid.Column="0" Classes="card" Content="{Binding TgDesktopShot}" IsChecked="{Binding SelDesktopShot}" IsEnabled="{Binding EnDesktopShot}" ToolTip.Tip="{Binding TipDesktopShot}" ToolTip.ShowOnDisabled="True"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <RadioButton Classes="subRadio" GroupName="desktopLayout"
                                                         Content="{Binding TgDesktopScreenshot}"
                                                         IsChecked="{Binding DesktopScreenshotGewaehlt, Mode=TwoWay}"
                                                         IsEnabled="{Binding EnDesktopScreenshot}"
                                                         ToolTip.Tip="{Binding TipDesktopScreenshot}" ToolTip.ShowOnDisabled="True"/>
                                            <RadioButton Classes="subRadio" GroupName="desktopLayout"
                                                         Content="{Binding TgDesktopSymbole}"
                                                         IsChecked="{Binding DesktopSymboleGewaehlt, Mode=TwoWay}"
                                                         IsEnabled="{Binding EnDesktopSymbole}"
                                                         ToolTip.Tip="{Binding TipDesktopSymbole}" ToolTip.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                    </Grid>
                </Border>

                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Border IsVisible="{Binding ProgressVisible}" Margin="0,0,0,8"
                            Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource Surface0Brush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="action" Content="{Binding BtnExecute}"
                            Command="{Binding ExecuteCommand}" IsEnabled="{Binding UiEnabled}"/>
                </StackPanel>
            </Grid>

            <!-- ============ Rechte Spalte: Protokoll ============ -->
            <Border Grid.Column="1" Classes="panel" Margin="0" Padding="14">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="{Binding LogTitle}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="secondary" Content="{Binding BtnClearLog}"
                                Padding="10,4" FontSize="11" Command="{Binding ClearLogCommand}"/>
                    </Grid>

                    <!-- Update-Streifen: erscheint nur, wenn es wirklich etwas Neues gibt.
                         Der Klick auf die Fläche öffnet nichts mehr von selbst - beide
                         Schaltflächen sagen ausdrücklich, was sie tun. -->
                    <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}"
                            BorderBrush="{DynamicResource YellowBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="10,7" Margin="0,0,0,10"
                            IsVisible="{Binding UpdateAvailable}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource YellowBrush}" FontSize="11" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Text="{Binding UpdateBannerText}"/>
                                <TextBlock Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Text="{Binding BannerHint}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                                    Padding="10,4" FontSize="11"
                                    Content="{Binding BtnUpdateNotes}"
                                    Command="{Binding OpenUpdateNotesCommand}"/>
                            <Button Grid.Column="2" Classes="action" VerticalAlignment="Center"
                                    Margin="6,0,0,0" Padding="10,4" FontSize="11"
                                    Content="{Binding BtnUpdateNow}"
                                    Command="{Binding UpdateProgramCommand}"
                                    IsEnabled="{Binding UiEnabled}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CrustBrush}"
                            BorderBrush="{DynamicResource Surface0Brush}" BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer Name="LogScroll" Padding="8"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Name="TBLog"
                                     Foreground="{DynamicResource GreenBrush}"
                                     FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11"
                                     TextWrapping="Wrap"
                                     Text="{Binding LogText}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
