<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>WindowsDaSiTool</AssemblyName>
    <Product>Windows DaSi Tool</Product>
    <AssemblyTitle>Windows DaSi Tool</AssemblyTitle>
    <Version>1.0.0</Version>
    <Description>Backup- und Restore-Tool fuer Windows-Benutzerprofile</Description>

    <!-- Fenster-Icon der EXE -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Debug-Symbole (.pdb) nicht mit ausgeben. Betrifft auch die nativen
         PDBs von SkiaSharp/HarfBuzzSharp (libSkiaSharp.pdb, libHarfBuzzSharp.pdb),
         die sonst im publish-Ordner landen, zur Laufzeit aber nicht gebraucht
         werden. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- System.Text.Encoding.CodePages wurde entfernt: Ab .NET 10 ist die
         Funktionalitaet (CodePagesEncodingProvider fuer Codepage 850) im
         Framework enthalten. Das separate Paket ist unnoetig (Warnung NU1510).
         Der Registrierungscode in Program.cs bleibt unveraendert und funktioniert. -->
    <!-- Diese (nur unter Linux genutzte) D-Bus-Abhaengigkeit kommt ueber
         Avalonia.Desktop transitiv herein. Wir setzen sie explizit auf die
         neueste Version 0.94.2 - deutlich ueber der fuer CVE-2026-39959 (HIGH)
         gepatchten 0.92.0, also CVE-frei. Unter Windows nicht ausgefuehrt. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
