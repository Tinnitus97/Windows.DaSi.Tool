<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Deliberately .NET 10 (LTS), also pinned in global.json: built with
         .NET 11 (version 1.2.0), the EXE did not start on Windows 10 computers.
         The build always uses the latest LTS version: the workflows get their
         SDK through .github/actions/dotnet-lts, and the weekly check
         (.github/workflows/dotnet-version.yml) turns red as soon as a new LTS
         version comes out (.NET 12, expected in November 2027). It skips STS
         versions like .NET 11. Before switching: test on Windows 10. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>WindowsDaSiTool</AssemblyName>
    <Product>Windows DaSi Tool</Product>
    <AssemblyTitle>Windows DaSi Tool</AssemblyTitle>
    <Version>1.2.8</Version>
    <Description>Backup- und Restore-Tool fuer Windows-Benutzerprofile</Description>

    <!-- Window icon of the EXE -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Do not emit debug symbols (.pdb). This also covers the native PDBs of
         SkiaSharp/HarfBuzzSharp (libSkiaSharp.pdb, libHarfBuzzSharp.pdb), which
         would otherwise land in the publish folder but are not needed at
         runtime. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- System.Text.Encoding.CodePages was removed: since .NET 10 the
         functionality (CodePagesEncodingProvider for code page 850) is part of
         the framework. The separate package is not needed (warning NU1510).
         The registration code in Program.cs stays unchanged and works. -->
    <!-- This D-Bus dependency (used on Linux only) comes in transitively via
         Avalonia.Desktop. We pin it explicitly to the latest version - well
         above 0.92.0, which patched CVE-2026-39959 (HIGH), so free of known
         CVEs. Not executed on Windows. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- The UI tests (tests/DaSiGuiTests) set the hooks for the folder
       dialog, the browser and the winget fake, which are only visible
       internally. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DaSiGuiTests" />
  </ItemGroup>

  <!--
    The project file lives in the repository root. From there the .NET SDK
    collects EVERY .cs file - including those of the test projects under
    tests\. That would result in two entry points (error CS0017).
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="publish/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

</Project>
